#cloud-config
package_update: true
package_upgrade: true
packages:
  - wireguard
  - qrencode
  - tcpdump

write_files:
  - path: /etc/sysctl.d/99-wireguard.conf
    content: |
      net.ipv4.ip_forward = 1

  - path: /etc/wireguard/wg0.conf
    permissions: '0600'
    content: |
      [Interface]
      Address = 10.8.0.1/24
      ListenPort = 51820
      PostUp = wg set %i private-key /etc/wireguard/server.key
      PostUp = iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE
      PostUp = iptables -I FORWARD -i %i -o %i -j DROP
      PostUp = iptables -I FORWARD -i %i -d 169.254.169.254 -j DROP
      PostUp = iptables -I FORWARD -i %i -d 168.63.129.16 -j DROP
      PostUp = iptables -I INPUT -i %i -p tcp --dport 22 ! -s 10.8.0.2 -j DROP
      PostDown = iptables -t nat -D POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE
      PostDown = iptables -D FORWARD -i %i -o %i -j DROP
      PostDown = iptables -D FORWARD -i %i -d 169.254.169.254 -j DROP
      PostDown = iptables -D FORWARD -i %i -d 168.63.129.16 -j DROP
      PostDown = iptables -D INPUT -i %i -p tcp --dport 22 ! -s 10.8.0.2 -j DROP

      # Client: admin
      [Peer]
      PublicKey = ${admin_public_key}
      AllowedIPs = 10.8.0.2/32

  - path: /etc/wireguard/myvpn.env
    permissions: '0600'
    content: |
      ENDPOINT="${endpoint}:51820"
      CLIENT_ALLOWED_IPS="0.0.0.0/0, ::/0"

  - path: /usr/local/sbin/add_client.sh
    permissions: '0755'
    content: |
      ${indent(6, add_client)}

  - path: /usr/local/sbin/remove_client.sh
    permissions: '0755'
    content: |
      ${indent(6, remove_client)}

  - path: /usr/local/sbin/list_clients.sh
    permissions: '0755'
    content: |
      ${indent(6, list_clients)}

runcmd:
  - chmod 700 /etc/wireguard
  - sh -c 'umask 077; wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub'
  - sysctl --system
  - systemctl enable --now wg-quick@wg0

power_state:
  mode: reboot
  condition: test -f /var/run/reboot-required