#cloud-config
package_update: true
package_upgrade: true
packages:
  - wireguard
  - qrencode
  - tcpdump

write_files:
  - path: /etc/sysctl.d/99-wireguard.conf
    content: |
      net.ipv4.ip_forward = 1

  - path: /etc/sysctl.d/99-zz-hardening.conf
    content: |
      fs.protected_fifos = 2
      fs.suid_dumpable = 0
      kernel.core_uses_pid = 1
      kernel.kptr_restrict = 2
      kernel.sysrq = 0
      kernel.unprivileged_bpf_disabled = 1
      net.core.bpf_jit_harden = 2
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.default.log_martians = 1
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0

  - path: /etc/modprobe.d/disable-rare-protocols.conf
    content: |
      install dccp /bin/true
      install sctp /bin/true
      install rds /bin/true
      install tipc /bin/true
      blacklist dccp
      blacklist sctp
      blacklist rds
      blacklist tipc

  - path: /etc/security/limits.conf
    append: true
    content: |
      * hard core 0

  - path: /etc/ssh/sshd_config.d/01-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      MaxAuthTries 3
      MaxSessions 2
      LogLevel VERBOSE
      AllowTcpForwarding no
      AllowAgentForwarding no
      X11Forwarding no
      TCPKeepAlive no
      ClientAliveInterval 300
      ClientAliveCountMax 2
      KexAlgorithms -ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group14-sha256
      HostKeyAlgorithms -ecdsa-sha2-nistp256
      MACs -hmac-sha1,hmac-sha1-etm@openssh.com,hmac-sha2-256,hmac-sha2-512,umac-64@openssh.com,umac-64-etm@openssh.com,umac-128@openssh.com

  - path: /etc/wireguard/wg0.conf
    permissions: '0600'
    content: |
      [Interface]
      Address = 10.8.0.1/24
      ListenPort = 51820
      PostUp = wg set %i private-key /etc/wireguard/server.key
      PostUp = iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE
      PostUp = iptables -I FORWARD -i %i -o %i -j DROP
      PostUp = iptables -I FORWARD -i %i -d 169.254.169.254 -j DROP
      PostUp = iptables -I FORWARD -i %i -d 168.63.129.16 -j DROP
      PostUp = iptables -I INPUT -i %i -p tcp --dport 22 ! -s 10.8.0.2 -j DROP
      PostDown = iptables -t nat -D POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE
      PostDown = iptables -D FORWARD -i %i -o %i -j DROP
      PostDown = iptables -D FORWARD -i %i -d 169.254.169.254 -j DROP
      PostDown = iptables -D FORWARD -i %i -d 168.63.129.16 -j DROP
      PostDown = iptables -D INPUT -i %i -p tcp --dport 22 ! -s 10.8.0.2 -j DROP

      # Client: admin
      [Peer]
      PublicKey = ${admin_public_key}
      AllowedIPs = 10.8.0.2/32

  - path: /etc/wireguard/myvpn.env
    permissions: '0600'
    content: |
      ENDPOINT="${endpoint}:51820"
      CLIENT_ALLOWED_IPS="0.0.0.0/0, ::/0"

  - path: /usr/local/sbin/add_client.sh
    permissions: '0755'
    content: |
      ${indent(6, add_client)}

  - path: /usr/local/sbin/remove_client.sh
    permissions: '0755'
    content: |
      ${indent(6, remove_client)}

  - path: /usr/local/sbin/list_clients.sh
    permissions: '0755'
    content: |
      ${indent(6, list_clients)}

runcmd:
  - chmod 700 /etc/wireguard
  - sh -c 'umask 077; wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub'
  - systemctl disable --now apport || true
  - sysctl --system
  - sshd -t && systemctl try-reload-or-restart ssh
  - systemctl enable --now wg-quick@wg0

power_state:
  mode: reboot
  condition: test -f /var/run/reboot-required